# Maintainer: RembrandtZ4 <RembrandtZ4 at users dot noreply dot github dot com>

pkgname=neonote
pkgver=1.3
pkgrel=1
epoch=1
pkgdesc="Music and video player inspired by Windows Media Player 12 (Qt 6, mpv, lyrics, Jellyfin)"
arch=('any')
url="https://github.com/RembrandtZ4/NeoNote-Media-Player"
license=('GPL-3.0-only')
depends=(
  'python'
  'pyside6'
  'qt6-multimedia'
  'qt6-multimedia-ffmpeg'
  'python-mutagen'
  'mpv'
  'python-mpv'
  'python-jeepney'
)
optdepends=(
  'xdg-utils: open folders if no file manager is reachable via D-Bus'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')   # setzt der Release-Workflow (updpkgsums)

package() {
  cd "NeoNote-Media-Player-$pkgver"
  install -Dm644 neonote.py             "$pkgdir/usr/share/neonote/neonote.py"
  install -Dm644 i18n/en.json           "$pkgdir/usr/share/neonote/i18n/en.json"
  install -Dm755 neonote.sh             "$pkgdir/usr/bin/neonote"
  install -Dm644 neonote.desktop        "$pkgdir/usr/share/applications/neonote.desktop"
  install -Dm644 neonote.png            "$pkgdir/usr/share/icons/hicolor/256x256/apps/neonote.png"
  install -Dm644 LICENSE                "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
  install -Dm644 README.md              "$pkgdir/usr/share/doc/$pkgname/README.md"
}
